<Window x:Class="HelloWpfApp.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HelloWpfApp"
        mc:Ignorable="d"
        Title="Đăng nhập hệ thống" Height="328" Width="618" WindowStartupLocation="CenterScreen">
    <Grid x:Name="loginWindow" RenderTransformOrigin="0.5,1.011">
        <Label Content="Login Mananagemetn System" HorizontalAlignment="Center" Margin="0,22,0,0" VerticalAlignment="Top" FontSize="30" FontWeight="Bold" Foreground="#FF3D762F"/>
        <Label Content="_Username: " 
               Target="{Binding ElementName=txtUsername}"
               HorizontalAlignment="Left" Margin="138,107,0,0" VerticalAlignment="Top" FontSize="20"/>
        <TextBox x:Name="txtUsername" HorizontalAlignment="Left" Margin="252,111,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="289" RenderTransformOrigin="0.497,0.592" FontSize="20"/>
        <Label Content="_Password: " 
               Target="{Binding ElementName=txtPassword}"
               HorizontalAlignment="Left" Margin="138,160,0,0" VerticalAlignment="Top" FontSize="20"/>
        <PasswordBox x:Name="txtPassword" HorizontalAlignment="Left" Margin="252,168,0,0" VerticalAlignment="Top" Width="289" FontSize="20"/>
        <Button x:Name="btnLogin" Content="Login" HorizontalAlignment="Left" Margin="252,244,0,0" VerticalAlignment="Top" FontSize="20" Width="102" Height="31" BorderBrush="#FF000303" Background="White" Click="btnLogin_Click"/>
        <Button x:Name="btnExist" Content="Exist" HorizontalAlignment="Left" Margin="445,244,0,0" VerticalAlignment="Top" FontSize="20" Width="96" Background="White" BorderBrush="Black" Click="btnExist_Click"/>
    </Grid>
</Window>
